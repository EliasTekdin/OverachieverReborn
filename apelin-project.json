  "package": {
    "id": "com.ilyastekdin.overachieverreborn",
    "name": "Overachiever Reborn",
    "version": "1.0.0",
    "description": "Community rebuild of Overachiever for rootless and roothide jailbreaks.",
    "longDescription": [
      "A community rebuild of Overachiever for modern rootless and roothide jailbreak environments.",
      "When enabled, it loads Game Center achievement descriptions and current progress, then reports incomplete achievements at 100 percent.",
      "It observes Game Center authentication changes and avoids repeating completed or already-submitted achievements in the current process.",
      "Requires a GameKit host, MobileSubstrate-compatible injection, and an authenticated Game Center account.",
      "Game Center behavior varies by game and account; this tweak does not guarantee success for every title or account."
    ],
    "icon": "https://owngoal-dev.github.io/Apelin/icons/wiki.qaq.apelin.dev.tweak.png",
    "author": "Ilya Stekdin",
    "section": "Tweaks",
    "depends": ["mobilesubstrate"],
    "layout": [
      { "path": "/Library/MobileSubstrate/DynamicLibraries/OverachieverReborn.dylib", "product": "tweak" }
    ],
    "tweakFilter": { "dylib": "tweak", "bundles": ["com.apple.GameKit"] }
